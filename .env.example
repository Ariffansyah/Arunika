# Supabase project settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... (safe in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... server only: saves assessments and runs the rate limiter. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# https://console.groq.com/keys (server only, never prefix with NEXT_PUBLIC_)
GROQ_API_KEY=
